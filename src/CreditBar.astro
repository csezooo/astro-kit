---
/**
 * "Építette és karbantartja: WeboldaltMost" sáv – minden oldal aljára.
 * Fekete sáv, Poppins thin 12px, a WeboldaltMost sárga link.
 * Szöveg/szín/link: src/config.ts (WM.brand)
 */
import { WM } from './config';
---

<div class="wm-credit-bar">
  {WM.brand.creditText} <a href={WM.brand.url} target="_blank" rel="noopener">{WM.brand.name}</a>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@100&display=swap');

  .wm-credit-bar {
    background: #000;
    color: #fff;
    text-align: center;
    padding: 8px 16px;
    font-family: 'Poppins', sans-serif;
    font-weight: 100;
    font-size: 12px;
    line-height: 1.4;
  }
  .wm-credit-bar a {
    color: var(--wm-credit-color, #F5C400);
    text-decoration: none;
  }
  .wm-credit-bar a:hover { text-decoration: underline; }
</style>
